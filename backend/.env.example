# MarineSpace Backend Environment Variables
# Copy this to .env and fill in your values

# Google Gemini API
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Upstash Redis
REDIS_URL=
REDIS_TOKEN=

# Copernicus Marine
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ISRO MOSDAC
MOSDOC_USERNAME=
MOSDAC_PASSWORD=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Debug mode
DEBUG=true
